{
  "hosting": [
    {
      "target": "main",
      "public": ".",
      "ignore": ["firebase.json", "app/**", "scripts/**", "data/**", "partials/**", "*.md", "LICENSE", "vercel.json", ".git/**", ".firebaserc", ".vercel/**", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "redirects": [{ "source": "/notes/note-02", "destination": "/notes/trading", "type": 301 }]
    },
    {
      "target": "app",
      "public": "app/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }]
    }
  ]
}
